---
const cafes = [
    { nombre: 'JON SNOW', img: 'images/jon.png', fondo: 'images/fondos/fondo_jon.png', descripcion: 'Americano con leche condensada', precio: '2.20€' },
    { nombre: 'DRAGÓN FUJUR', img: 'images/fuju.png', fondo: 'images/fondos/fondo_fuju.png', descripcion: 'Café con leche y leche condensada', precio: '2.30€' },
    { nombre: 'ABEJA MAYA', img: 'images/maya.png', fondo: 'images/fondos/fondo_maya.png', descripcion: 'Café con leche y miel', precio: '2.30€' },
    { nombre: 'HUARGO FANTASMA', img: 'images/huargo.png', fondo: 'images/fondos/fondo_huargo.png', descripcion: 'Americano con leche condensada y nata', precio: '3.80€', imgClass: 'w-xs' },
    { nombre: 'PRINCESA MONONOKE', img: 'images/mononoke.png', fondo: 'images/fondos/fondo_mononoke.png', descripcion: 'Café con leche cacao y nata', precio: '3.80€' },
    { nombre: 'MAGO BELGARATH', img: 'images/mago.png', fondo: 'images/fondos/fondo_mago.png', descripcion: 'Americano bola de helado y nata', precio: '4.50€' },
    { nombre: 'ARYA STARK', img: 'images/arya.png', fondo: 'images/fondos/fondo_arya.png', descripcion: 'Café con leche bola de helado y nata', precio: '4.50€' },
    { nombre: 'BELLATRIX', img: 'images/bellatrix.png', fondo: 'images/fondos/fondo_bellatrix.png', descripcion: 'Americano con licor de avellana y nata', precio: '4.50€' },
    { nombre: 'MONJE PANDAREN', img: 'images/panda.png', fondo: 'images/fondos/fondo_panda.png', descripcion: 'Café con leche, baileys y nata', precio: '4.50€' },
    { nombre: 'SIRIUS BLACK', img: 'images/sirius.png', fondo: 'images/fondos/fondo_sirius.png', descripcion: 'Americano con licor café y nata', precio: '4.50€' },
    { nombre: 'PROFESOR LUPIN', img: 'images/lupin.png', fondo: 'images/fondos/fondo_lupin.png', descripcion: 'Café con leche, crema de orujo y nata', precio: '4.50€' },
    { nombre: 'FLAMBEADO DE MOU', img: 'images/flambeado.png', fondo: 'images/fondos/fondo_flambeado.png', descripcion: 'Americano con whisky flambeado y nata', precio: '3.50€' },
];

const capuccino = []
---

<section class="flex flex-col p-10 justify-center items-center pt-20">
    <!--Cafes Especiales -->
    <h2 class="text-6xl mb-10 font-bold text-fuchsia-900 font-Mountain-Bold">CAFÉS ESPECIALES</h2>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-y-10 gap-4">
        {
            cafes.map((cafe) => (
                <div class="flex flex-col justify-between items-center bg-cover bg-center rounded-2xl" style={`background-image: url('${cafe.fondo}')`}>
                    <img class={cafe.imgClass ?? 'w-md'} src={cafe.img}>
                    <div class="flex flex-col bg-black mb-5 p-5 rounded-2xl">
                        <h4 class="font-bold text-3xl font-Cinzel">{cafe.nombre}</h4>
                        <p>{cafe.descripcion}</p>
                        <p class="text-2xl font-Nabla">{cafe.precio}</p>
                    </div>
                </div>
            ))
        }
    </div>
    <!--Capuccino latte -->
    <h2 class="text-6xl mb-10 font-bold text-fuchsia-900 font-Mountain-Bold pt-10">CAPUCCINO LATTE</h2>
    <div class=" bg-black rounded-2xl flex flex-col justify-center items-center">
        <div class="grid grid-cols-2 justify-center items-center">
            <img src="images/riuk_sinfondo.png" class="w-md">
            <ul class="flex flex-col gap-2">
                <li class="font-bold text-3xl font-Cinzel text-green-700">PISTACHO</li>
                <li class="font-bold text-3xl font-Cinzel text-amber-700">AVELLANA</li>
                <li class="font-bold text-3xl font-Cinzel text-red-900">RED VELVET</li>
                <li class="font-bold text-3xl font-Cinzel text-amber-500">CARAMELO</li>
                <li class="font-bold text-3xl font-Cinzel text-blue-300">VAINILLAZUL</li>
                <li class=" mt-5 text-5xl font-Nabla">2.50€</li>
            </ul>
            <!-- <p class="col-span-2 text-center text-5xl font-Nabla">2.50€</p> -->
        </div>
    </div>

</section>